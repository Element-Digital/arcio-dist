#!/usr/bin/env bash
set -euo pipefail

# arcioctl — the Arcio supervisor.
#
# Runs on the HOST — the Arcio OS appliance, or any machine using the Docker
# install method — and drives `docker compose`. Run `arcioctl` with no
# arguments for the command list.
#
# It is a script on the host rather than a privileged container holding the
# Docker socket. A container with that socket mounted is root-equivalent on the
# host, and nothing here needs that much reach — so the application container
# keeps NoNewPrivileges and holds no privilege of its own.

PROJECT_DIR="${ARCIO_DIR:-/opt/arcio}"
BACKUP_DIR="${ARCIO_BACKUP_DIR:-${PROJECT_DIR}/backups}"
KEEP_BACKUPS="${ARCIO_KEEP_BACKUPS:-14}"
HEALTH_TIMEOUT="${ARCIO_HEALTH_TIMEOUT:-180}"

compose() { docker compose "$@"; }
say() { printf '\033[0;36m›\033[0m %s\n' "$*"; }
ok() { printf '\033[0;32m✓\033[0m %s\n' "$*"; }
die() { printf '\033[0;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
arcioctl — the Arcio supervisor.

Usage:  arcioctl <command> [arguments]

  status               what is running, and whether it is healthy
  logs [service]       follow the logs, application by default
  backup               back up the database and data volume, timestamped
  restore <file>       restore from a backup archive
  update [tag]         pull, migrate, verify, and roll back if it fails
  import <bundle>      load a signed offline image bundle
  diagnostics          write a support bundle to ./diagnostics/

On the Arcio OS appliance:

  os-status            the OS version, and whether an update is staged
  os-update [version]  take an OS update, then reboot

Documentation:  https://arcio.au/docs/
USAGE
}

current_image() { compose config --images 2>/dev/null | grep -m1 'arcio' || true; }

# Healthy means the app answers, not that the container is running. A container
# that started and then failed its first query is "up" to Docker and useless to
# a user, and that is precisely the state an update must not be left in.
wait_healthy() {
  local waited=0
  while [ "${waited}" -lt "${HEALTH_TIMEOUT}" ]; do
    if compose exec -T arcio curl -fsS http://127.0.0.1:3001/api/health >/dev/null 2>&1; then
      return 0
    fi
    sleep 3
    waited=$((waited + 3))
  done
  return 1
}

cmd_status() {
  compose ps
  echo
  if compose exec -T arcio curl -fsS http://127.0.0.1:3001/api/health 2>/dev/null; then
    echo
    ok "Healthy"
  else
    die "Not answering on /api/health"
  fi
}

cmd_backup() {
  mkdir -p "${BACKUP_DIR}"
  local stamp archive
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  archive="${BACKUP_DIR}/arcio-${stamp}.tar.gz"
  local work
  work="$(mktemp -d)"
  # ${work:-}, not ${work}. A RETURN trap is set on the shell, not scoped to the
  # function that set it, so it fires again when the *caller* returns. By then
  # the local is gone and `set -u` kills the script with "work: unbound
  # variable" after the work has already succeeded. It hit `arcioctl update`
  # too, which calls this the same way, and surfaced when os-update did.
  trap 'rm -rf "${work:-}" 2>/dev/null || true' RETURN

  say "Dumping the database..."
  compose exec -T db pg_dump -U arcio -d arcio --clean --if-exists > "${work}/arcio.sql"

  # The data volume carries secrets.env. A dump without FIELD_ENCRYPTION_KEY
  # restores every table and decrypts none of the credentials in them, which is
  # a restore that looks like it worked — so the two travel together.
  say "Copying the data volume..."
  docker run --rm -v arcio_arcio-data:/data:ro -v "${work}:/out" alpine:3 \
    tar -czf /out/data.tar.gz -C /data . 2>/dev/null

  tar -czf "${archive}" -C "${work}" arcio.sql data.tar.gz
  chmod 600 "${archive}"

  # Verify rather than assume. A backup nobody has read is a hypothesis.
  tar -tzf "${archive}" >/dev/null || die "Archive did not verify: ${archive}"

  ls -1t "${BACKUP_DIR}"/arcio-*.tar.gz 2>/dev/null | tail -n "+$((KEEP_BACKUPS + 1))" \
    | xargs -r rm -f

  ok "Backup: ${archive} ($(du -h "${archive}" | cut -f1))"
  echo "${archive}"
}

cmd_restore() {
  local archive="${1:-}"
  [ -f "${archive}" ] || die "Usage: arcioctl restore <archive.tar.gz>"
  local work
  work="$(mktemp -d)"
  # ${work:-}, not ${work}. A RETURN trap is set on the shell, not scoped to the
  # function that set it, so it fires again when the *caller* returns. By then
  # the local is gone and `set -u` kills the script with "work: unbound
  # variable" after the work has already succeeded. It hit `arcioctl update`
  # too, which calls this the same way, and surfaced when os-update did.
  trap 'rm -rf "${work:-}" 2>/dev/null || true' RETURN
  tar -xzf "${archive}" -C "${work}"

  say "Stopping the application (leaving the database up)..."
  compose stop arcio

  say "Restoring the database..."
  compose exec -T db psql -U arcio -d arcio -v ON_ERROR_STOP=1 < "${work}/arcio.sql"

  say "Restoring the data volume..."
  docker run --rm -v arcio_arcio-data:/data -v "${work}:/in:ro" alpine:3 \
    sh -c 'rm -rf /data/* && tar -xzf /in/data.tar.gz -C /data'

  compose up -d arcio
  wait_healthy || die "Restored, but the application is not healthy. Check: arcioctl logs"
  ok "Restored from ${archive}"
}

cmd_update() {
  local target="${1:-}"
  local previous
  previous="$(current_image)"
  say "Currently running: ${previous:-unknown}"

  # Before the pull, not after. Migrations are forward-only — `prisma migrate
  # deploy` has no down step — so once a new version has altered the schema,
  # putting the old image back is not a rollback on its own. The backup is what
  # makes the rollback below real rather than aspirational.
  say "Taking a backup first..."
  local safety
  safety="$(cmd_backup | tail -1)"

  if [ -n "${target}" ]; then
    say "Pinning ARCIO_VERSION=${target}"
    if grep -q '^ARCIO_VERSION=' .env 2>/dev/null; then
      sed -i "s|^ARCIO_VERSION=.*|ARCIO_VERSION=${target}|" .env
    else
      echo "ARCIO_VERSION=${target}" >> .env
    fi
  fi

  say "Pulling..."
  compose pull arcio

  say "Restarting..."
  compose up -d arcio

  if wait_healthy; then
    ok "Updated and healthy."
    compose exec -T arcio curl -fsS http://127.0.0.1:3001/api/health
    return 0
  fi

  printf '\033[0;31m✗\033[0m %s\n' "New version did not become healthy — rolling back." >&2
  compose logs --tail 50 arcio >&2 || true
  cmd_restore "${safety}"
  die "Rolled back to the pre-update state. The failed version's logs are above."
}

# The air-gapped path: an image bundle carried in, rather than pulled.
cmd_import() {
  local bundle="${1:-}"
  [ -f "${bundle}" ] || die "Usage: arcioctl import <bundle.tar>"

  # Verified before it is loaded, not after. A bundle that arrived on a USB
  # stick has a worse provenance story than a registry pull, so the signature
  # is the only thing standing in for the transport.
  if command -v cosign >/dev/null 2>&1 && [ -f "${bundle}.sig" ]; then
    say "Verifying signature..."
    cosign verify-blob --signature "${bundle}.sig" \
      --certificate-identity-regexp 'https://github.com/Element-Digital/Arcio/.*' \
      --certificate-oidc-issuer https://token.actions.githubusercontent.com \
      "${bundle}" || die "Signature did not verify — do not load this bundle."
    ok "Signature verified."
  else
    printf '\033[0;33m!\033[0m %s\n' "No cosign or no .sig alongside the bundle — loading unverified." >&2
  fi

  say "Loading images..."
  docker load -i "${bundle}"
  ok "Loaded. Now: arcioctl update <tag>"
}

# The command-line route to a support bundle, for an appliance with nobody
# logged into the UI — and for an air-gapped install, where downloading and
# carrying the file out is the only path that exists.
#
# Goes through the app's own endpoint rather than reading the database, so the
# bundle is scrubbed by the same code the UI uses. A second implementation here
# would be a second thing to get wrong, and the thing it would get wrong is
# redaction.
cmd_diagnostics() {
  local days="${1:-7}"
  mkdir -p "${PROJECT_DIR}/diagnostics"
  say "Building a ${days}-day bundle..."
  local out
  out="${PROJECT_DIR}/diagnostics/arcio-diagnostics-$(date -u +%Y%m%dT%H%M%SZ).json"
  compose exec -T arcio node -e "
    import('./backend/dist/services/diagnostics.js').then(async (m) => {
      const b = await m.buildBundle({ days: ${days} });
      process.stdout.write(m.serialiseBundle(b));
    }).catch((e) => { console.error(e); process.exit(1); });
  " > "${out}" || die "Could not build a bundle — is the application running? arcioctl status"
  chmod 600 "${out}"
  ok "Bundle: ${out} ($(du -h "${out}" | cut -f1))"
  echo "Read it before you send it. Attach it to your support ticket."
}

# ── the operating system, on the appliance only ─────────────────────────────
#
# Arcio OS ships with Flatcar's updater masked. Stock Flatcar checks for an OS
# update about two minutes after boot and lets locksmithd reboot to apply it,
# which on an appliance means an outbound connection nobody put on the egress
# list and an unannounced reboot of the architecture repository.
#
# Masking it removes that, and creates an obligation: something has to patch the
# OS, deliberately, when an administrator says so. These two commands are that
# something.
#
# On the Docker install method the host is yours and you patch it the way you
# patch everything else, so they refuse rather than guess.

is_flatcar() { [ -f /etc/os-release ] && grep -q '^ID=flatcar' /etc/os-release; }

require_flatcar() {
  is_flatcar && return 0
  die "This is for the Arcio OS appliance. On the Docker install method the host is yours to patch."
}

# The channel the appliance follows. LTS, because an enterprise appliance should
# not be on a stream that moves every few weeks.
os_channel() { grep -m1 '^GROUP=' /etc/flatcar/update.conf 2>/dev/null | cut -d= -f2 || echo lts; }
os_version() { grep -m1 '^VERSION=' /etc/os-release | cut -d= -f2; }

cmd_os_status() {
  require_flatcar
  local channel current latest
  channel="$(os_channel)"
  current="$(os_version)"
  echo "Running:  ${current} (${channel})"

  # A staged update has been written to the passive partition and takes effect
  # on the next boot. Worth saying out loud, because the box is not running what
  # it is about to run.
  if [ -f /var/lib/arcio/.os-update-staged ]; then
    printf '\033[0;33m!\033[0m %s\n' "An update is staged. Reboot to apply it."
  fi

  # Deliberately last, and allowed to fail. An air-gapped appliance should still
  # get the useful half of this command.
  latest="$(curl -fsSL --max-time 10 \
    "https://${channel}.release.flatcar-linux.net/amd64-usr/current/version.txt" 2>/dev/null \
    | grep -m1 '^FLATCAR_VERSION=' | cut -d= -f2 || true)"
  if [ -z "${latest}" ]; then
    echo "Latest:   could not reach the release server"
  elif [ "${latest}" = "${current}" ]; then
    ok "Latest:   ${latest} — up to date"
  else
    printf '\033[0;33m!\033[0m %s\n' "Latest:   ${latest} — run: arcioctl os-update"
  fi
}

cmd_os_update() {
  require_flatcar
  [ "$(id -u)" = "0" ] || die "Needs root: sudo arcioctl os-update"

  local channel current target
  channel="$(os_channel)"
  current="$(os_version)"
  target="${1:-}"

  if [ -z "${target}" ]; then
    say "Asking ${channel}.release.flatcar-linux.net what is current..."
    target="$(curl -fsSL --max-time 20 \
      "https://${channel}.release.flatcar-linux.net/amd64-usr/current/version.txt" \
      | grep -m1 '^FLATCAR_VERSION=' | cut -d= -f2)" \
      || die "Could not reach the release server. Pass a version to update offline."
  fi

  [ "${target}" != "${current}" ] || { ok "Already on ${current}."; return 0; }

  say "Updating the OS: ${current} -> ${target}"
  echo "  This downloads to the passive partition. Nothing changes until you reboot,"
  echo "  and if the new version does not boot, the bootloader falls back."
  echo

  # Back up first, for the same reason `arcioctl update` does: the cheapest
  # moment to have a backup is before anything changes, and an OS update that
  # goes wrong is a worse afternoon than an application one.
  say "Taking a backup first..."
  cmd_backup >/dev/null

  # flatcar-update runs a temporary update service on localhost and unmasks
  # update-engine to talk to it. -A writes SERVER=disabled when it finishes, so
  # the automatic check does not quietly come back with it.
  say "Downloading and writing to the passive partition..."
  flatcar-update --to-version "${target}" --disable-afterwards

  # -A disables the server but leaves update-engine unmasked and says nothing
  # about locksmithd, so put both back the way the appliance ships. Otherwise
  # one OS update silently re-enables the reboot manager we removed.
  say "Re-masking the automatic updater..."
  systemctl mask --now update-engine.service locksmithd.service >/dev/null 2>&1 || true

  # -A overwrites the file, taking GROUP and REBOOT_STRATEGY with it.
  printf 'GROUP=%s\nREBOOT_STRATEGY=off\n' "${channel}" > /etc/flatcar/update.conf

  mkdir -p /var/lib/arcio
  touch /var/lib/arcio/.os-update-staged

  ok "Staged ${target}."
  echo
  echo "  Reboot when you are ready. Arcio comes back on its own:"
  echo "    sudo systemctl reboot"
  echo
  echo "  The old version stays on the other partition. If the new one does not"
  echo "  come up, the bootloader returns to it without you doing anything."
}

# Help before anything else, and before the working directory matters.
case "${1:-}" in
  ""|-h|--help|help) usage; exit 0 ;;
esac

[ -d "${PROJECT_DIR}" ] || die "No Arcio installation at ${PROJECT_DIR}.
  Point ARCIO_DIR at yours, or follow https://arcio.au/docs/install/docker/"
cd "${PROJECT_DIR}"

case "${1}" in
  status)  shift; cmd_status "$@" ;;
  os-status) shift; cmd_os_status "$@" ;;
  os-update) shift; cmd_os_update "$@" ;;
  diagnostics) shift; cmd_diagnostics "$@" ;;
  backup)  shift; cmd_backup "$@" >/dev/null && ok "Done" ;;
  restore) shift; cmd_restore "$@" ;;
  update)  shift; cmd_update "$@" ;;
  import)  shift; cmd_import "$@" ;;
  logs)    shift; compose logs -f "${1:-arcio}" ;;
  *)
    printf '\033[0;31m✗\033[0m Unknown command: %s\n\n' "${1}" >&2
    usage >&2
    exit 1
    ;;
esac
