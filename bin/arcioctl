#!/usr/bin/env bash
set -euo pipefail

# arcioctl — the Arcio supervisor.
#
# Runs on the HOST — the Arcio OS appliance, or any machine using the Docker
# install method — and drives `docker compose`. Run `arcioctl` with no
# arguments for the command list.
#
# It is a script on the host rather than a privileged container holding the
# Docker socket. A container with that socket mounted is root-equivalent on the
# host, and nothing here needs that much reach — so the application container
# keeps NoNewPrivileges and holds no privilege of its own.

PROJECT_DIR="${ARCIO_DIR:-/opt/arcio}"
BACKUP_DIR="${ARCIO_BACKUP_DIR:-${PROJECT_DIR}/backups}"
KEEP_BACKUPS="${ARCIO_KEEP_BACKUPS:-14}"
HEALTH_TIMEOUT="${ARCIO_HEALTH_TIMEOUT:-180}"

compose() { docker compose "$@"; }
say() { printf '\033[0;36m›\033[0m %s\n' "$*"; }
ok() { printf '\033[0;32m✓\033[0m %s\n' "$*"; }
die() { printf '\033[0;31m✗\033[0m %s\n' "$*" >&2; exit 1; }
warn() { printf '\033[0;33m!\033[0m %s\n' "$*" >&2; }

# Both repositories publish signed artefacts: the application images and the
# offline bundles from Arcio, the appliance images from arcio-dist. Either is a
# valid signer of something you would `import`.
COSIGN_IDENTITY_RE='https://github.com/Element-Digital/(Arcio|arcio-dist)/.*'
COSIGN_ISSUER='https://token.actions.githubusercontent.com'

# Verify a detached signature over a file, keylessly.
#
# ── Two things were wrong here ──────────────────────────────────────────────
#
# It passed `--signature` and never `--certificate`. Keyless verification needs
# the certificate to establish who signed; without it cosign does not fail the
# check, it refuses to run one:
#
#   Error: provide a key with --key or --sk, a certificate to verify against
#   with --certificate, or a bundle with --bundle
#
# The `|| die` caught that, so it failed closed rather than loading unverified
# — but it means `arcioctl import` could never accept a correctly signed
# bundle. The air-gapped install path did not work, and would not have worked
# for anybody who tried it.
#
# And cosign has since replaced both flags with a single `--bundle`, so even
# the corrected pair prints a deprecation notice on every run. New artefacts
# carry a bundle; the pair is still accepted for anything signed before the
# change, and for an operator running an older cosign.
verify_blob() {
  local blob="$1"

  if ! command -v cosign >/dev/null 2>&1; then
    warn "cosign is not installed, so ${blob} cannot be verified."
    warn "Install it from https://github.com/sigstore/cosign, or accept the risk knowingly."
    return 1
  fi

  local -a material
  if [ -f "${blob}.bundle" ]; then
    material=(--bundle "${blob}.bundle")
  elif [ -f "${blob}.sig" ] && [ -f "${blob}.pem" ]; then
    material=(--signature "${blob}.sig" --certificate "${blob}.pem")
  else
    warn "No ${blob}.bundle, and no ${blob}.sig with ${blob}.pem beside it."
    return 1
  fi

  cosign verify-blob "${material[@]}" \
    --certificate-identity-regexp "${COSIGN_IDENTITY_RE}" \
    --certificate-oidc-issuer "${COSIGN_ISSUER}" \
    "${blob}" >/dev/null 2>&1
}

usage() {
  cat <<'USAGE'
arcioctl — the Arcio supervisor.

Usage:  arcioctl <command> [arguments]

  status               what is running, and whether it is healthy
  logs [service]       the logs, application by default; follows on a terminal
  backup               back up the database and data volume, timestamped
  restore <file>       restore from a backup archive
  update [tag]         pull, migrate, verify, and roll back if it fails
  import <bundle>      load a signed offline image bundle
  diagnostics          write a support bundle to ./diagnostics/

On the Arcio OS appliance:

  os-status            the OS version, and whether an update is staged
  os-update [version]  take an OS update, then reboot

Documentation:  https://arcio.au/docs/
USAGE
}

current_image() { compose config --images 2>/dev/null | grep -m1 'arcio' || true; }

# Healthy means the app can serve a request, not that the container is running.
#
# A container that started and then failed its first query is "up" to Docker
# and useless to a user, and that is precisely the state an update must not be
# left in. This is the check `cmd_update` rolls back on, so what it accepts
# decides whether the rollback ever fires.
#
# `/api/ready` asks the application whether it can reach its database.
# `/api/health` only proves the listener is up, which is the right answer for
# the container's own HEALTHCHECK — Docker restarts on that one, and a database
# blip should not restart the app — and the wrong answer here.
#
# 404 means an image older than /api/ready, which happens on a rollback to a
# previous version and on any install whose arcioctl is newer than its image.
# Falling back to /api/health there is strictly better than refusing to
# recognise a perfectly healthy older release.
wait_healthy() {
  local waited=0 code
  while [ "${waited}" -lt "${HEALTH_TIMEOUT}" ]; do
    code="$(compose exec -T arcio curl -s -o /dev/null -w '%{http_code}' \
      http://127.0.0.1:3001/api/ready 2>/dev/null || true)"
    case "${code}" in
      200)
        return 0
        ;;
      404)
        if compose exec -T arcio curl -fsS http://127.0.0.1:3001/api/health >/dev/null 2>&1; then
          return 0
        fi
        ;;
    esac
    sleep 3
    waited=$((waited + 3))
  done
  return 1
}

# A fresh install has no administrator, and what its owner needs to know is not
# a health check. Asked of the app rather than guessed at: /api/setup/status
# says whether it has been claimed.
#
# The code itself is read out of the log, because there is no endpoint that
# hands it out and there is not going to be one — an unauthenticated endpoint
# that returns the credential for claiming an unclaimed install would defeat
# the entire point of having a code.
setup_notice() {
  local status code
  status="$(compose exec -T arcio curl -fsS http://127.0.0.1:3001/api/setup/status 2>/dev/null || true)"
  case "${status}" in
    *'"required":true'*) ;;
    *) return 0 ;;
  esac
  echo
  say "No administrator yet. Finish setup in a browser at this install's address."
  code="$(compose logs arcio 2>/dev/null \
    | grep -oE 'Setup code[^:]*: [A-Z0-9-]+' | tail -1 | sed 's/.*: //')"
  if [ -n "${code}" ]; then
    printf '  Setup code: %s\n' "${code}"
    printf '  Only needed once the install is more than 30 minutes old.\n'
  else
    printf '  The setup code is in the application log: arcioctl logs | grep -i "setup code"\n'
  fi
}

cmd_status() {
  compose ps
  echo

  # Decided on the status code, not on whether curl succeeded.
  #
  # The first version of this used `curl -fsS` and fell back to `/api/health`
  # on any failure, so a 503 from a perfectly modern image — the deep check
  # running and reporting the database unreachable — fell through to the
  # shallow endpoint and printed "this version has no database check". It had
  # the check. The check had failed. Stopping the database and reading the
  # output is how that was found.
  #
  # 404 is the only case that means "this image is older than /api/ready", and
  # it is the only case that falls back.
  local out code body
  out="$(compose exec -T arcio curl -s -w '\n%{http_code}' \
    http://127.0.0.1:3001/api/ready 2>/dev/null || true)"
  code="$(printf '%s' "${out}" | tail -1)"
  body="$(printf '%s' "${out}" | sed '$d')"

  case "${code}" in
    200)
      printf '%s\n' "${body}"
      ok "Healthy"
      ;;
    503)
      printf '%s\n' "${body}"
      die "Arcio is running but cannot reach its database. Try: arcioctl logs db"
      ;;
    404)
      if compose exec -T arcio curl -fsS http://127.0.0.1:3001/api/health 2>/dev/null; then
        echo
        ok "Healthy (this version is too old to check the database)"
      else
        die "Not answering on /api/health. Try: arcioctl logs"
      fi
      ;;
    *)
      die "Not answering at all${code:+ (HTTP ${code})}. Try: arcioctl logs"
      ;;
  esac
  setup_notice
}

# ── reporting a backup back into the product ────────────────────────────────
#
# An unmonitored backup is one nobody discovers has been failing for five
# weeks, which is why Settings › Backup exists. It reads a small JSON status
# file, and only the old LXC install script ever wrote one — so on the two
# install methods that are actually supported, Docker and the appliance, the
# nightly timer ran and the product reported "we cannot tell".
#
# The file goes in the data volume because that is the one place the host and
# the container both reach. The dumps themselves deliberately stay where the
# application cannot read them: a dump is the whole database, and the
# network-facing process has no business holding it. A status file is not.
DATA_VOLUME="${ARCIO_DATA_VOLUME:-arcio_arcio-data}"

# First 16 hex of sha256 over the key. Enough to prove two keys are the same
# one and useless for reconstructing it, which is what lets an operator tell
# whether the key in their vault is the one a given dump needs — before a
# disaster rather than during one. Same derivation as deploy/arcio-backup.sh,
# or the two would disagree about the same key.
# Fed in on stdin rather than built into `sh -c`, because the first version was
# a regex inside a double-quoted string inside a docker argument, and the
# quoting did not survive the trip. It silently matched nothing and hashed the
# empty string, which produces e3b0c44298fc1c14 — a fingerprint that looks
# perfectly valid, is identical on every install that hits the same bug, and
# would have "matched" a dump it had nothing to do with. Worse than no
# fingerprint, so now there is no fingerprint when there is no key.
key_fingerprint() {
  docker run --rm -i -v "${DATA_VOLUME}:/data:ro" alpine:3 sh -s 2>/dev/null <<'FINGERPRINT'
key=$(sed -n 's/^FIELD_ENCRYPTION_KEY=["'"'"']\{0,1\}\([0-9a-fA-F]\{64\}\).*/\1/p' \
      /data/secrets.env 2>/dev/null | head -1)
[ -n "${key}" ] || exit 0
printf '%s' "${key}" | sha256sum | cut -c1-16
FINGERPRINT
}

# Written on success and on failure, because "the last run failed" is the
# single most important thing this can say and a status file that only appears
# when things went well cannot say it.
write_backup_status() {
  local ok_flag="$1" started="$2" archive="$3" bytes="$4" duration="$5" error="$6"
  local fp count work
  count="$(find "${BACKUP_DIR}" -maxdepth 1 -name 'arcio-*.tar.gz' -type f 2>/dev/null | wc -l)"
  fp="$(key_fingerprint || true)"
  work="$(mktemp -d)"
  cat > "${work}/backup-status.json" <<JSON
{
  "startedAt": "${started}",
  "finishedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "ok": ${ok_flag},
  "path": "${archive}",
  "sizeBytes": ${bytes:-0},
  "durationMs": ${duration:-0},
  "keyFingerprint": "${fp}",
  "keptDays": ${KEEP_BACKUPS},
  "backupCount": ${count:-0},
  "error": "${error}"
}
JSON
  docker run --rm -v "${DATA_VOLUME}:/data" -v "${work}:/in:ro" alpine:3 \
    sh -c 'cp /in/backup-status.json /data/backup-status.json && chmod 644 /data/backup-status.json' \
    >/dev/null 2>&1 || warn "Could not write the backup status into ${DATA_VOLUME}."
  rm -rf "${work}"
}

# Report the failure, then stop. Every step below calls this explicitly instead
# of trusting `set -e`, for the reason in cmd_backup's own comment.
backup_failed() {
  local started="$1" archive="$2" reason="$3"
  write_backup_status false "${started}" "${archive}" 0 0 "${reason}"
  die "Backup failed: ${reason}"
}

# ── Why nothing here trusts `set -e` ────────────────────────────────────────
#
# It does not apply. `set -e` is suppressed for every command inside a function
# that is itself part of a `&&` list or a command substitution, and this
# function is invoked both ways: `cmd_backup ... && ok "Done"` from the command
# dispatcher, and `safety="$(cmd_backup | tail -1)"` from cmd_update.
#
# That is not a theoretical hole. With the database stopped, `docker compose
# exec` exits 1 and writes nothing; the redirect still created the file, every
# later step succeeded on an empty dump, and `arcioctl backup` printed a tick
# over a 925-byte archive containing no database. The pre-update safety backup
# cmd_update takes could be that file, and the rollback would restore it.
#
# So each step is checked by hand, and the result is verified rather than
# assumed: a backup nobody has read is a hypothesis.
cmd_backup() {
  mkdir -p "${BACKUP_DIR}"
  local stamp archive started started_ms
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  started="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  started_ms="$(date +%s%3N)"
  archive="${BACKUP_DIR}/arcio-${stamp}.tar.gz"

  local work
  work="$(mktemp -d)"
  # ${work:-}, not ${work}. A RETURN trap is set on the shell, not scoped to the
  # function that set it, so it fires again when the *caller* returns. By then
  # the local is gone and `set -u` kills the script with "work: unbound
  # variable" after the work has already succeeded. It hit `arcioctl update`
  # too, which calls this the same way, and surfaced when os-update did.
  trap 'rm -rf "${work:-}" 2>/dev/null || true' RETURN

  say "Dumping the database..."
  if ! compose exec -T db pg_dump -U arcio -d arcio --clean --if-exists > "${work}/arcio.sql"; then
    backup_failed "${started}" "${archive}" "pg_dump failed — is the database running?"
  fi

  # An exit code is not enough on its own. Check the dump says what a dump
  # says, so that anything which writes zero bytes and claims success is
  # caught here rather than discovered during a restore.
  if ! head -c 4096 "${work}/arcio.sql" | grep -q 'PostgreSQL database dump'; then
    backup_failed "${started}" "${archive}" \
      "the dump is not a PostgreSQL dump ($(wc -c < "${work}/arcio.sql") bytes)"
  fi

  # The data volume carries secrets.env. A dump without FIELD_ENCRYPTION_KEY
  # restores every table and decrypts none of the credentials in them, which is
  # a restore that looks like it worked — so the two travel together.
  say "Copying the data volume..."
  if ! docker run --rm -v "${DATA_VOLUME}:/data:ro" -v "${work}:/out" alpine:3 \
       tar -czf /out/data.tar.gz -C /data . 2>/dev/null; then
    backup_failed "${started}" "${archive}" "could not read the ${DATA_VOLUME} volume"
  fi

  if ! tar -czf "${archive}" -C "${work}" arcio.sql data.tar.gz; then
    backup_failed "${started}" "${archive}" "could not write ${archive}"
  fi
  chmod 600 "${archive}"

  # Verify rather than assume. A backup nobody has read is a hypothesis.
  if ! tar -tzf "${archive}" >/dev/null 2>&1; then
    backup_failed "${started}" "${archive}" "the archive did not verify"
  fi

  ls -1t "${BACKUP_DIR}"/arcio-*.tar.gz 2>/dev/null | tail -n "+$((KEEP_BACKUPS + 1))" \
    | xargs -r rm -f


  write_backup_status true "${started}" "${archive}" \
    "$(stat -c %s "${archive}")" "$(( $(date +%s%3N) - started_ms ))" ""

  ok "Backup: ${archive} ($(du -h "${archive}" | cut -f1))"
  echo "${archive}"
}

cmd_restore() {
  local archive="${1:-}"
  [ -f "${archive}" ] || die "Usage: arcioctl restore <archive.tar.gz>"
  local work
  work="$(mktemp -d)"
  # ${work:-}, not ${work}. A RETURN trap is set on the shell, not scoped to the
  # function that set it, so it fires again when the *caller* returns. By then
  # the local is gone and `set -u` kills the script with "work: unbound
  # variable" after the work has already succeeded. It hit `arcioctl update`
  # too, which calls this the same way, and surfaced when os-update did.
  trap 'rm -rf "${work:-}" 2>/dev/null || true' RETURN
  tar -xzf "${archive}" -C "${work}"

  say "Stopping the application (leaving the database up)..."
  compose stop arcio

  say "Restoring the database..."
  compose exec -T db psql -U arcio -d arcio -v ON_ERROR_STOP=1 < "${work}/arcio.sql"

  say "Restoring the data volume..."
  docker run --rm -v "${DATA_VOLUME}:/data" -v "${work}:/in:ro" alpine:3 \
    sh -c 'rm -rf /data/* && tar -xzf /in/data.tar.gz -C /data'

  compose up -d arcio
  wait_healthy || die "Restored, but the application is not healthy. Check: arcioctl logs"
  ok "Restored from ${archive}"
}

cmd_update() {
  local target="${1:-}"
  local previous
  previous="$(current_image)"
  say "Currently running: ${previous:-unknown}"

  # Before the pull, not after. Migrations are forward-only — `prisma migrate
  # deploy` has no down step — so once a new version has altered the schema,
  # putting the old image back is not a rollback on its own. The backup is what
  # makes the rollback below real rather than aspirational.
  say "Taking a backup first..."
  local safety
  safety="$(cmd_backup | tail -1)"

  if [ -n "${target}" ]; then
    say "Pinning ARCIO_VERSION=${target}"
    if grep -q '^ARCIO_VERSION=' .env 2>/dev/null; then
      sed -i "s|^ARCIO_VERSION=.*|ARCIO_VERSION=${target}|" .env
    else
      echo "ARCIO_VERSION=${target}" >> .env
    fi
  fi

  say "Pulling..."
  compose pull arcio

  say "Restarting..."
  compose up -d arcio

  if wait_healthy; then
    ok "Updated and healthy."
    compose exec -T arcio curl -fsS http://127.0.0.1:3001/api/health
    return 0
  fi

  printf '\033[0;31m✗\033[0m %s\n' "New version did not become healthy — rolling back." >&2
  compose logs --tail 50 arcio >&2 || true
  cmd_restore "${safety}"
  die "Rolled back to the pre-update state. The failed version's logs are above."
}

# The air-gapped path: an image bundle carried in, rather than pulled.
cmd_import() {
  local bundle="${1:-}"
  [ -f "${bundle}" ] || die "Usage: arcioctl import <bundle.tar>"

  # Verified before it is loaded, not after. A bundle that arrived on a USB
  # stick has a worse provenance story than a registry pull, so the signature
  # is the only thing standing in for the transport.
  #
  # Three outcomes, kept distinct on purpose. A signature that does not verify
  # is a refusal: the bytes are not what was signed and nothing good follows
  # from loading them. Missing material, or no cosign, is a warning and a
  # prompt, because an air-gapped operator who has deliberately carried an
  # unsigned tarball in should not be stopped by a tool that cannot tell the
  # two situations apart.
  say "Verifying signature..."
  if verify_blob "${bundle}"; then
    ok "Signature verified."
  elif [ -f "${bundle}.bundle" ] || { [ -f "${bundle}.sig" ] && [ -f "${bundle}.pem" ]; }; then
    die "Signature did not verify — do not load this bundle."
  elif [ "${ARCIO_IMPORT_UNVERIFIED:-}" = "yes" ]; then
    warn "Loading ${bundle} without verifying it, because ARCIO_IMPORT_UNVERIFIED=yes."
  else
    die "Refusing to load an unverified bundle. Set ARCIO_IMPORT_UNVERIFIED=yes to override."
  fi

  say "Loading images..."
  docker load -i "${bundle}"
  ok "Loaded. Now: arcioctl update <tag>"
}

# The command-line route to a support bundle, for an appliance with nobody
# logged into the UI — and for an air-gapped install, where downloading and
# carrying the file out is the only path that exists.
#
# Goes through the app's own endpoint rather than reading the database, so the
# bundle is scrubbed by the same code the UI uses. A second implementation here
# would be a second thing to get wrong, and the thing it would get wrong is
# redaction.
cmd_diagnostics() {
  local days="${1:-7}"
  mkdir -p "${PROJECT_DIR}/diagnostics"
  say "Building a ${days}-day bundle..."
  local out
  out="${PROJECT_DIR}/diagnostics/arcio-diagnostics-$(date -u +%Y%m%dT%H%M%SZ).json"
  compose exec -T arcio node -e "
    import('./backend/dist/services/diagnostics.js').then(async (m) => {
      const b = await m.buildBundle({ days: ${days} });
      process.stdout.write(m.serialiseBundle(b));
    }).catch((e) => { console.error(e); process.exit(1); });
  " > "${out}" || die "Could not build a bundle — is the application running? arcioctl status"
  chmod 600 "${out}"
  ok "Bundle: ${out} ($(du -h "${out}" | cut -f1))"
  echo "Read it before you send it. Attach it to your support ticket."
}

# ── the operating system, on the appliance only ─────────────────────────────
#
# Arcio OS ships with Flatcar's updater masked. Stock Flatcar checks for an OS
# update about two minutes after boot and lets locksmithd reboot to apply it,
# which on an appliance means an outbound connection nobody put on the egress
# list and an unannounced reboot of the architecture repository.
#
# Masking it removes that, and creates an obligation: something has to patch the
# OS, deliberately, when an administrator says so. These two commands are that
# something.
#
# On the Docker install method the host is yours and you patch it the way you
# patch everything else, so they refuse rather than guess.

is_flatcar() { [ -f /etc/os-release ] && grep -q '^ID=flatcar' /etc/os-release; }

require_flatcar() {
  is_flatcar && return 0
  die "This is for the Arcio OS appliance. On the Docker install method the host is yours to patch."
}

# The channel the appliance follows. LTS, because an enterprise appliance should
# not be on a stream that moves every few weeks.
os_channel() { grep -m1 '^GROUP=' /etc/flatcar/update.conf 2>/dev/null | cut -d= -f2 || echo lts; }
os_version() { grep -m1 '^VERSION=' /etc/os-release | cut -d= -f2; }

cmd_os_status() {
  require_flatcar
  local channel current latest
  channel="$(os_channel)"
  current="$(os_version)"
  echo "Running:  ${current} (${channel})"

  # A staged update has been written to the passive partition and takes effect
  # on the next boot. Worth saying out loud, because the box is not running what
  # it is about to run.
  if [ -f /var/lib/arcio/.os-update-staged ]; then
    printf '\033[0;33m!\033[0m %s\n' "An update is staged. Reboot to apply it."
  fi

  # Deliberately last, and allowed to fail. An air-gapped appliance should still
  # get the useful half of this command.
  latest="$(curl -fsSL --max-time 10 \
    "https://${channel}.release.flatcar-linux.net/amd64-usr/current/version.txt" 2>/dev/null \
    | grep -m1 '^FLATCAR_VERSION=' | cut -d= -f2 || true)"
  if [ -z "${latest}" ]; then
    echo "Latest:   could not reach the release server"
  elif [ "${latest}" = "${current}" ]; then
    ok "Latest:   ${latest} — up to date"
  else
    printf '\033[0;33m!\033[0m %s\n' "Latest:   ${latest} — run: arcioctl os-update"
  fi
}

cmd_os_update() {
  require_flatcar
  [ "$(id -u)" = "0" ] || die "Needs root: sudo arcioctl os-update"

  local channel current target
  channel="$(os_channel)"
  current="$(os_version)"
  target="${1:-}"

  if [ -z "${target}" ]; then
    say "Asking ${channel}.release.flatcar-linux.net what is current..."
    target="$(curl -fsSL --max-time 20 \
      "https://${channel}.release.flatcar-linux.net/amd64-usr/current/version.txt" \
      | grep -m1 '^FLATCAR_VERSION=' | cut -d= -f2)" \
      || die "Could not reach the release server. Pass a version to update offline."
  fi

  [ "${target}" != "${current}" ] || { ok "Already on ${current}."; return 0; }

  say "Updating the OS: ${current} -> ${target}"
  echo "  This downloads to the passive partition. Nothing changes until you reboot,"
  echo "  and if the new version does not boot, the bootloader falls back."
  echo

  # Back up first, for the same reason `arcioctl update` does: the cheapest
  # moment to have a backup is before anything changes, and an OS update that
  # goes wrong is a worse afternoon than an application one.
  say "Taking a backup first..."
  cmd_backup >/dev/null

  # flatcar-update runs a temporary update service on localhost and unmasks
  # update-engine to talk to it. -A writes SERVER=disabled when it finishes, so
  # the automatic check does not quietly come back with it.
  say "Downloading and writing to the passive partition..."
  flatcar-update --to-version "${target}" --disable-afterwards

  # -A disables the server but leaves update-engine unmasked and says nothing
  # about locksmithd, so put both back the way the appliance ships. Otherwise
  # one OS update silently re-enables the reboot manager we removed.
  say "Re-masking the automatic updater..."
  systemctl mask --now update-engine.service locksmithd.service >/dev/null 2>&1 || true

  # -A overwrites the file, taking GROUP and REBOOT_STRATEGY with it.
  printf 'GROUP=%s\nREBOOT_STRATEGY=off\n' "${channel}" > /etc/flatcar/update.conf

  mkdir -p /var/lib/arcio
  touch /var/lib/arcio/.os-update-staged

  ok "Staged ${target}."
  echo
  echo "  Reboot when you are ready. Arcio comes back on its own:"
  echo "    sudo systemctl reboot"
  echo
  echo "  The old version stays on the other partition. If the new one does not"
  echo "  come up, the bootloader returns to it without you doing anything."
}

# Help before anything else, and before the working directory matters.
case "${1:-}" in
  ""|-h|--help|help) usage; exit 0 ;;
esac

[ -d "${PROJECT_DIR}" ] || die "No Arcio installation at ${PROJECT_DIR}.
  Point ARCIO_DIR at yours, or follow https://arcio.au/docs/install/docker/"
cd "${PROJECT_DIR}"

case "${1}" in
  status)  shift; cmd_status "$@" ;;
  os-status) shift; cmd_os_status "$@" ;;
  os-update) shift; cmd_os_update "$@" ;;
  diagnostics) shift; cmd_diagnostics "$@" ;;
  # Not `&& ok "Done"`: a command on the left of `&&` runs with errexit
  # suppressed throughout, which is half of why a failed dump used to report
  # success. cmd_backup checks itself now, and this no longer disarms it.
  backup)  shift; cmd_backup "$@" >/dev/null; ok "Done" ;;
  restore) shift; cmd_restore "$@" ;;
  update)  shift; cmd_update "$@" ;;
  import)  shift; cmd_import "$@" ;;
  # Follow only when somebody is watching. The appliance's own console banner
  # says to run `arcioctl logs | grep -i password` to find the administrator
  # password, and with an unconditional -f that command prints the password and
  # then hangs for ever: the pipe never closes, grep never exits, and the first
  # thing a new owner does leaves them at what looks like a frozen terminal.
  # `[ -t 1 ]` is false in a pipe, a redirect and a `$( )`, which is exactly the
  # set of cases where following is wrong anyway.
  logs)
    shift
    if [ -t 1 ]; then compose logs -f "${1:-arcio}"; else compose logs "${1:-arcio}"; fi
    ;;
  *)
    printf '\033[0;31m✗\033[0m Unknown command: %s\n\n' "${1}" >&2
    usage >&2
    exit 1
    ;;
esac
